---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Logo from '../../components/Logo.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map(comparison => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

const { comparison } = Astro.props;
const { Content } = await comparison.render();

const { data } = comparison;
const { title, description, publishDate, lastUpdated, author, category, mainSoftware, alternatives } = data;
---

<Layout title={`${title} - Alternative Logiciel`} description={description}>
  <article class="pt-28 pb-24 px-4">
    <div class="max-w-6xl mx-auto">
      
      {/* Header */}
      <header class="mb-24 text-center">
        <div class="mb-8">
          <a href="/comparatifs" class="inline-flex items-center gap-2 text-purple-400 hover:text-purple-300 transition-colors text-lg">
            <i class="fas fa-arrow-left"></i> Retour aux comparatifs
          </a>
        </div>
        
        <span class="inline-flex items-center px-5 py-2.5 rounded-full text-base font-medium bg-purple-500/10 text-purple-400 mb-8">
          {category}
        </span>
        
        <h1 class="text-5xl md:text-6xl font-bold mb-8 leading-tight">{title}</h1>
        
        <p class="text-2xl text-[var(--color-text-secondary)] mb-10 max-w-4xl mx-auto leading-relaxed">{description}</p>
        
        <div class="flex flex-wrap items-center justify-center gap-8 text-base text-[var(--color-text-muted)]">
          <span class="flex items-center gap-2"><i class="fas fa-user text-purple-400"></i> {author}</span>
          <span class="flex items-center gap-2"><i class="fas fa-calendar text-purple-400"></i> {publishDate.toLocaleDateString('fr-FR')}</span>
          {lastUpdated && lastUpdated.getTime() !== publishDate.getTime() && (
            <span class="flex items-center gap-2"><i class="fas fa-sync text-purple-400"></i> MàJ {lastUpdated.toLocaleDateString('fr-FR')}</span>
          )}
        </div>
      </header>

      {/* Logiciel principal */}
      {mainSoftware && (
        <section class="mb-32">
          <div class="flex items-center gap-4 mb-10">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center shadow-lg shadow-purple-500/25">
              <i class="fas fa-crown text-white text-2xl"></i>
            </div>
            <h2 class="text-4xl font-bold">Logiciel de référence</h2>
          </div>
          
          <div class="bg-gradient-to-br from-[var(--color-bg-secondary)] to-[var(--color-bg-tertiary)] border border-[var(--color-border)] p-12 rounded-3xl shadow-2xl">
            <div class="flex items-center gap-6 mb-6">
              <Logo name={mainSoftware.name} size={56} />
              <h3 class="text-4xl font-bold text-purple-400">{mainSoftware.name}</h3>
            </div>
            
            <p class="text-xl text-[var(--color-text-secondary)] mb-10 leading-relaxed max-w-4xl">{mainSoftware.description}</p>
            
            <div class="flex flex-wrap items-center gap-8 mb-12">
              <span class="text-3xl font-bold text-white bg-purple-600 px-6 py-3 rounded-2xl shadow-lg shadow-purple-600/25">{mainSoftware.price}</span>
              <span class="flex items-center gap-3 text-2xl text-yellow-400">
                <i class="fas fa-star text-3xl"></i>
                <span class="font-bold">{mainSoftware.rating}</span>
                <span class="text-[var(--color-text-muted)] text-xl">/5</span>
              </span>
              <a href={mainSoftware.website} target="_blank" rel="noopener" 
                 class="inline-flex items-center gap-3 px-8 py-4 bg-[var(--color-bg-primary)] border border-[var(--color-border)] rounded-2xl text-purple-400 hover:text-purple-300 hover:border-purple-400 transition-all text-lg">
                Site officiel <i class="fas fa-external-link-alt"></i>
              </a>
            </div>

            <div class="grid md:grid-cols-2 gap-10">
              <div class="bg-green-500/5 border border-green-500/20 rounded-2xl p-8">
                <h4 class="font-bold mb-6 text-green-400 text-xl flex items-center gap-3">
                  <i class="fas fa-check-circle text-2xl"></i> Avantages
                </h4>
                <ul class="space-y-4">
                  {mainSoftware.pros.map(pro => (
                    <li class="flex items-start gap-4 text-[var(--color-text-secondary)] text-lg leading-relaxed">
                      <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 text-sm">✓</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="bg-red-500/5 border border-red-500/20 rounded-2xl p-8">
                <h4 class="font-bold mb-6 text-red-400 text-xl flex items-center gap-3">
                  <i class="fas fa-times-circle text-2xl"></i> Inconvénients
                </h4>
                <ul class="space-y-4">
                  {mainSoftware.cons.map(con => (
                    <li class="flex items-start gap-4 text-[var(--color-text-secondary)] text-lg leading-relaxed">
                      <span class="flex-shrink-0 w-8 h-8 rounded-full bg-red-500/20 flex items-center justify-center text-red-400 text-sm">×</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Séparateur */}
      <div class="flex items-center gap-6 mb-16">
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"></div>
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center shadow-lg shadow-purple-500/25">
            <span class="text-2xl font-bold text-white">{alternatives.length}</span>
          </div>
          <div>
            <h2 class="text-4xl font-bold">Alternatives</h2>
            <p class="text-[var(--color-text-muted)] text-lg mt-1">Testées et comparées pour vous</p>
          </div>
        </div>
        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-purple-500/50 to-transparent"></div>
      </div>

      {/* Liste des alternatives */}
      <div class="space-y-16 mb-32">
        {alternatives.map((alt, index) => (
          <div class="bg-gradient-to-br from-[var(--color-bg-secondary)] to-[var(--color-bg-tertiary)] border border-[var(--color-border)] rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-shadow">
            {/* Header de l'alternative */}
            <div class="p-10 md:p-12 border-b border-[var(--color-border)]">
              <div class="flex flex-col lg:flex-row lg:items-start gap-8">
                {/* Numéro */}
                <div class="flex-shrink-0">
                  <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-3xl font-bold text-white shadow-lg shadow-purple-500/25">
                    #{index + 1}
                  </div>
                </div>
                
                <div class="flex-1">
                  {/* Titre et badges avec logo */}
                  <div class="flex flex-wrap items-center gap-4 mb-6">
                    <div class="flex items-center gap-4">
                      <Logo name={alt.name} size={48} />
                      <h3 class="text-3xl font-bold">{alt.name}</h3>
                    </div>
                    {alt.openSource && (
                      <span class="px-4 py-2 rounded-full text-base bg-green-500/20 text-green-400 font-medium border border-green-500/30">
                        <i class="fas fa-code-branch mr-2"></i> Open Source
                      </span>
                    )}
                  </div>
                  
                  <p class="text-xl text-[var(--color-text-secondary)] mb-8 leading-relaxed max-w-4xl">{alt.description}</p>
                  
                  {/* Prix et note */}
                  <div class="flex flex-wrap items-center gap-8 mb-8">
                    <span class="text-2xl font-bold text-purple-400">{alt.price}</span>
                    <span class="flex items-center gap-3 text-xl">
                      <i class="fas fa-star text-yellow-400 text-2xl"></i>
                      <span class="font-bold">{alt.rating}</span>
                      <span class="text-[var(--color-text-muted)]">/5</span>
                    </span>
                    <a href={alt.website} target="_blank" rel="noopener" 
                       class="inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] text-purple-400 hover:text-purple-300 hover:border-purple-400 transition-all">
                      Site officiel <i class="fas fa-external-link-alt"></i>
                    </a>
                  </div>

                  {/* Best for */}
                  {alt.bestFor && (
                    <div class="flex items-start gap-4 p-6 bg-blue-500/5 border border-blue-500/20 rounded-2xl">
                      <i class="fas fa-user-check text-blue-400 text-xl mt-1"></i>
                      <div class="text-lg">
                        <span class="font-semibold text-blue-400">Idéal pour :</span>
                        <span class="text-[var(--color-text-secondary)] ml-2">{alt.bestFor}</span>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* Pros et Cons */}
            <div class="p-10 md:p-12">
              <div class="grid md:grid-cols-2 gap-12">
                <div>
                  <h4 class="font-bold mb-8 text-green-400 text-2xl flex items-center gap-3">
                    <i class="fas fa-thumbs-up text-3xl"></i> Points forts
                  </h4>
                  <ul class="space-y-6">
                    {alt.pros.map(pro => (
                      <li class="flex items-start gap-4 text-[var(--color-text-secondary)] text-lg leading-relaxed">
                        <span class="flex-shrink-0 w-10 h-10 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 font-bold">✓</span>
                        <span>{pro}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="font-bold mb-8 text-red-400 text-2xl flex items-center gap-3">
                    <i class="fas fa-thumbs-down text-3xl"></i> Points faibles
                  </h4>
                  <ul class="space-y-6">
                    {alt.cons.map(con => (
                      <li class="flex items-start gap-4 text-[var(--color-text-secondary)] text-lg leading-relaxed">
                        <span class="flex-shrink-0 w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center text-red-400 font-bold">×</span>
                        <span>{con}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Contenu Markdown */}
      <div class="prose prose-invert prose-2xl max-w-none">
        <Content />
      </div>

      {/* CTA */}
      <div class="mt-32 bg-gradient-to-br from-[var(--color-bg-secondary)] to-[var(--color-bg-tertiary)] border border-[var(--color-border)] p-16 rounded-3xl text-center shadow-2xl">
        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center mx-auto mb-8 shadow-lg shadow-purple-500/25">
          <i class="fas fa-question text-white text-3xl"></i>
        </div>
        <h3 class="text-3xl font-bold mb-6">Une question sur ces alternatives ?</h3>
        <p class="text-xl text-[var(--color-text-secondary)] mb-10 max-w-2xl mx-auto leading-relaxed">Notre équipe peut vous aider à choisir la meilleure solution pour vos besoins spécifiques.</p>
        <a href="mailto:esl.agentsa@gmail.com" 
           class="inline-flex items-center gap-4 px-10 py-5 bg-purple-600 text-white rounded-2xl hover:bg-purple-500 transition-all text-xl font-medium shadow-lg shadow-purple-600/25">
          <i class="fas fa-envelope"></i> Nous contacter
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose {
    color: var(--color-text-primary);
  }
  .prose h2 {
    color: var(--color-text-primary);
    margin-top: 5rem;
    margin-bottom: 2rem;
    font-size: 2.5rem;
    font-weight: 700;
  }
  .prose h3 {
    color: var(--color-text-primary);
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    font-size: 2rem;
    font-weight: 600;
  }
  .prose p {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 2;
    font-size: 1.25rem;
  }
  .prose ul {
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    margin-left: 2rem;
  }
  .prose ul li {
    margin-bottom: 1rem;
    line-height: 1.8;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 3rem 0;
    font-size: 1.125rem;
  }
  .prose th {
    background: var(--color-bg-tertiary);
    padding: 1.25rem;
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid var(--color-border);
  }
  .prose td {
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose tr:hover {
    background: rgba(139, 92, 246, 0.05);
  }
  .prose strong {
    color: var(--color-text-primary);
  }
  .prose blockquote {
    border-left: 4px solid var(--color-primary-500);
    padding-left: 2rem;
    margin: 2.5rem 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }
  
  /* Verdict Cards - Improved */
  .verdict-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }
  
  .verdict-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(59, 130, 246, 0.1));
    border: 2px solid rgba(139, 92, 246, 0.3);
    border-radius: 1rem;
    padding: 1.5rem;
    transition: all 0.3s ease;
  }
  
  .verdict-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 92, 246, 0.6);
    box-shadow: 0 20px 40px rgba(124, 58, 237, 0.2);
  }
  
  .verdict-card h3 {
    margin: 0 0 0.75rem 0 !important;
    font-size: 1.1rem !important;
    color: var(--color-text-primary);
  }
  
  .verdict-card strong {
    display: block;
    font-size: 1.25rem;
    color: #a855f7;
    margin-bottom: 0.75rem;
  }
  
  .verdict-card p {
    margin: 0;
    line-height: 1.6;
    font-size: 1rem;
  }

  /* Better Table Styling */
  .prose table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2.5rem 0;
    font-size: 1rem;
    background: var(--color-bg-secondary);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }
  
  .prose thead {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.2));
  }
  
  .prose th {
    padding: 1.25rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-primary);
    border-bottom: 2px solid rgba(139, 92, 246, 0.3);
    white-space: nowrap;
  }
  
  .prose td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  
  .prose tbody tr:hover {
    background: rgba(139, 92, 246, 0.05);
  }
  
  .prose tbody tr:last-child td {
    border-bottom: none;
  }

  /* FAQ better spacing */
  .prose h3 + p,
  .prose h2 + p {
    margin-top: 1rem;
  }

  /* Emoji sizing */
  .prose h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
