---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map(comparison => ({
    params: { slug: comparison.slug },
    props: { comparison },
  }));
}

const { comparison } = Astro.props;
const { Content } = await comparison.render();

const { data } = comparison;
const { title, description, publishDate, lastUpdated, author, category, mainSoftware, alternatives } = data;
---

<Layout title={`${title} - Alternative Logiciel`} description={description}>
  <article class="pt-24 pb-12 px-4">
    <div class="max-w-4xl mx-auto">
      {/* Header */}
      <header class="mb-8">
        <div class="flex items-center gap-2 mb-4">
          <a href="/comparatifs" class="text-sm text-purple-400 hover:text-purple-300">← Retour aux comparatifs</a>
        </div>
        
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-500/10 text-purple-400 mb-4">
          {category}
        </span>
        
        <h1 class="text-3xl md:text-4xl font-bold mb-4">{title}</h1>
        
        <p class="text-xl text-[var(--color-text-secondary)] mb-6">{description}</p>
        
        <div class="flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-muted)]">
          <span><i class="fas fa-user"></i> {author}</span>
          <span><i class="fas fa-calendar"></i> Publié le {publishDate.toLocaleDateString('fr-FR')}</span>
          {lastUpdated && lastUpdated.getTime() !== publishDate.getTime() && (
            <span><i class="fas fa-sync"></i> MàJ {lastUpdated.toLocaleDateString('fr-FR')}</span>
          )}
        </div>
      </header>

      {/* Logiciel principal */}
      {mainSoftware && (
        <section class="glass-card p-6 mb-8">
          <div class="flex items-start gap-4">
            <div class="flex-1">
              <h2 class="text-xl font-bold mb-2">Logiciel de référence : {mainSoftware.name}</h2>
              <p class="text-[var(--color-text-secondary)] mb-4">{mainSoftware.description}</p>
              
              <div class="flex flex-wrap items-center gap-4 mb-4">
                <span class="text-lg font-bold text-purple-400">{mainSoftware.price}</span>
                <span class="flex items-center gap-1 text-yellow-400">
                  <i class="fas fa-star"></i> {mainSoftware.rating}/5
                </span>
                <a href={mainSoftware.website} target="_blank" rel="noopener" class="text-purple-400 hover:text-purple-300">
                  Site officiel <i class="fas fa-external-link-alt text-xs"></i>
                </a>
              </div>

              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <h4 class="font-semibold mb-2 text-green-400"><i class="fas fa-check-circle"></i> Avantages</h4>
                  <ul class="text-sm text-[var(--color-text-secondary)] space-y-1">
                    {mainSoftware.pros.map(pro => <li>• {pro}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold mb-2 text-red-400"><i class="fas fa-times-circle"></i> Inconvénients</h4>
                  <ul class="text-sm text-[var(--color-text-secondary)] space-y-1">
                    {mainSoftware.cons.map(con => <li>• {con}</li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Compteur d'alternatives */}
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">{alternatives.length} Alternatives</h2>
        <span class="text-sm text-[var(--color-text-muted)]">Classées par pertinence</span>
      </div>

      {/* Liste des alternatives */}
      <div class="space-y-6 mb-12">
        {alternatives.map((alt, index) => (
          <div class="glass-card p-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500/20 to-blue-500/20 flex items-center justify-center text-xl font-bold text-purple-400">
                {index + 1}
              </div>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-3 mb-2">
                  <h3 class="text-xl font-bold">{alt.name}</h3>
                  {alt.openSource && (
                    <span class="px-2 py-0.5 rounded text-xs bg-green-500/20 text-green-400">Open Source</span>
                  )}
                </div>
                
                <p class="text-[var(--color-text-secondary)] mb-3">{alt.description}</p>
                
                <div class="flex flex-wrap items-center gap-4 mb-4">
                  <span class="font-semibold text-purple-400">{alt.price}</span>
                  <span class="flex items-center gap-1 text-yellow-400">
                    <i class="fas fa-star"></i> {alt.rating}/5
                  </span>
                  <a href={alt.website} target="_blank" rel="noopener" class="text-purple-400 hover:text-purple-300 text-sm">
                    Site officiel <i class="fas fa-external-link-alt text-xs"></i>
                  </a>
                </div>

                {alt.bestFor && (
                  <p class="text-sm text-[var(--color-text-muted)] mb-3">
                    <i class="fas fa-user-check"></i> <strong>Idéal pour :</strong> {alt.bestFor}
                  </p>
                )}

                <div class="grid md:grid-cols-2 gap-4 pt-4 border-t border-[var(--color-border)]">
                  <div>
                    <h4 class="font-semibold mb-2 text-green-400 text-sm"><i class="fas fa-check"></i> Points forts</h4>
                    <ul class="text-sm text-[var(--color-text-secondary)] space-y-1">
                      {alt.pros.map(pro => <li>✓ {pro}</li>)}
                    </ul>
                  </div>
                  <div>
                    <h4 class="font-semibold mb-2 text-red-400 text-sm"><i class="fas fa-times"></i> Points faibles</h4>
                    <ul class="text-sm text-[var(--color-text-secondary)] space-y-1">
                      {alt.cons.map(con => <li>× {con}</li>)}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Contenu Markdown */}
      <div class="prose prose-invert prose-lg max-w-none">
        <Content />
      </div>

      {/* CTA */}
      <div class="mt-12 glass-card p-8 text-center">
        <h3 class="text-xl font-bold mb-2">Une question sur ces alternatives ?</h3>
        <p class="text-[var(--color-text-secondary)] mb-4">Contactez-nous pour des conseils personnalisés</p>
        <a href="mailto:esl.agentsa@gmail.com" class="inline-flex items-center px-6 py-3 bg-purple-600 text-white rounded-xl hover:bg-purple-500 transition-colors">
          <i class="fas fa-envelope mr-2"></i> Nous contacter
        </a>
      </div>
    </div>
  </article>
</Layout>

<style>
  .prose {
    color: var(--color-text-primary);
  }
  .prose h2 {
    color: var(--color-text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  .prose h3 {
    color: var(--color-text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .prose ul {
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
  }
  .prose th {
    background: var(--color-bg-tertiary);
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
  }
  .prose td {
    padding: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
</style>
