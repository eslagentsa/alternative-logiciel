---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Contact - Alternative Logiciel",
  description: "Contactez-nous pour toute question, suggestion ou demande de comparatif."
};
---

<Layout {...seo}>
  <div class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-violet-400 to-blue-400 bg-clip-text text-transparent mb-8 text-center">
        Contactez-nous
      </h1>
      
      <p class="text-slate-400 text-lg text-center mb-12 max-w-2xl mx-auto">
        Une question sur un comparatif ? Une suggestion d'outil à tester ? 
        Ou simplement envie de discuter productivité ? Écrivez-nous !
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Contact Form -->
        <div class="glass-card p-8 rounded-2xl">
          <h2 class="text-2xl font-bold text-white mb-6">Envoyer un message</h2>
          <form class="space-y-6" action="mailto:esl.agentsa@gmail.com" method="post" enctype="text/plain">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Nom</label>
              <input 
                type="text" 
                name="name"
                class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 transition-colors"
                placeholder="Votre nom"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Email</label>
              <input 
                type="email" 
                name="email"
                class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 transition-colors"
                placeholder="votre@email.com"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Sujet</label>
              <select 
                name="subject"
                class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white focus:outline-none focus:border-violet-500 transition-colors"
              >
                <option value="question">Question sur un comparatif</option>
                <option value="suggestion">Suggestion d'outil</option>
                <option value="partnership">Partenariat</option>
                <option value="other">Autre</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Message</label>
              <textarea 
                name="message"
                rows="5"
                class="w-full px-4 py-3 bg-slate-800/50 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:border-violet-500 transition-colors resize-none"
                placeholder="Votre message..."
              ></textarea>
            </div>
            <button 
              type="submit"
              class="w-full px-6 py-4 bg-gradient-to-r from-violet-600 to-blue-600 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
            >
              Envoyer le message
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-6">
          <div class="glass-card p-6 rounded-2xl">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-violet-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Email</h3>
                <a href="mailto:esl.agentsa@gmail.com" class="text-slate-400 hover:text-violet-400 transition-colors">
                  esl.agentsa@gmail.com
                </a>
              </div>
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Temps de réponse</h3>
                <p class="text-slate-400">Nous répondons généralement sous 24-48h ouvrées.</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-pink-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">Localisation</h3>
                <p class="text-slate-400">France - Luxembourg</p>
              </div>
            </div>
          </div>

          <div class="glass-card p-6 rounded-2xl bg-gradient-to-br from-violet-600/20 to-blue-600/20">
            <h3 class="font-semibold text-white mb-2">💡 Astuce</h3>
            <p class="text-slate-300 text-sm">
              Pour une réponse plus rapide concernant un comparatif spécifique, 
              mentionnez le nom exact de l'article dans votre message.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>