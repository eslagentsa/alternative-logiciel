{
  "$ref": "#/definitions/comparisons",
  "definitions": {
    "comparisons": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "heroImage": {
          "type": "string"
        },
        "mainSoftware": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            },
            "price": {
              "type": "string"
            },
            "rating": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "website": {
              "type": "string",
              "format": "uri"
            },
            "pros": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name",
            "description",
            "price",
            "rating",
            "website",
            "pros",
            "cons"
          ],
          "additionalProperties": false
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "logo": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "rating": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "website": {
                "type": "string",
                "format": "uri"
              },
              "openSource": {
                "type": "boolean",
                "default": false
              },
              "pros": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "description",
              "price",
              "rating",
              "website",
              "pros",
              "cons"
            ],
            "additionalProperties": false
          }
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "lastUpdated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "author": {
          "type": "string",
          "default": "Équipe Alternative Logiciel"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "mainSoftware",
        "alternatives",
        "publishDate",
        "lastUpdated"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}